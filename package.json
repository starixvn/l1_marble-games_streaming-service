{
  "name": "streaming-service",
  "version": "1.0.0",
  "description": "Streaming service for Marble TV",
  "repository": {
    "type": "git",
    "url": "git@git3.nexdev.net:l1/marble-games/live-streaming/streaming-service.git"
  },
  "author": "",
  "license": "ISC",
  "main": "./build/app.js",
  "type": "module",
  "scripts": {
    "start": "node --experimental-loader=extensionless ./build/app.js",
    "dev": "cross-env NODE_ENV=development tsx watch ./src/app.ts",
    "reg": "npm set registry http://npm.lumigame.com",
    "build": "tsc && copyfiles -u 1 public/* build/public",
    "watch": "tsc -w",
    "test": "jest --testPathPatterns=tests/unit-tests/",
    "test-coverage": "jest --collect-coverage --testPathPatterns=tests/unit-tests/",
    "format": "prettier --write \"src/**/*.{ts,js,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,json}\"",
    "lint": "npm run format:check",
    "check:deps": "npm-check-updates",
    "update:deps": "npm-check-updates -u"
  },
  "jestSonar": {
    "reportPath": "reports",
    "reportFile": "test-reporter.xml",
    "indent": 4
  },
  "dependencies": {
    "awilix": "12.0.5",
    "chance": "1.1.13",
    "cors": "2.8.5",
    "cron": "4.3.4",
    "cross-env": "10.1.0",
    "dayjs": "1.11.19",
    "dotenv": "17.2.3",
    "express": "5.1.0",
    "extensionless": "2.0.2",
    "jest-mock-extended": "4.0.0",
    "jsonwebtoken": "9.0.2",
    "odds-feed-client": "3.7.1",
    "sc-common": "3.0.0",
    "sc-core-rng": "1.1.0",
    "tldts": "7.0.17"
  },
  "devDependencies": {
    "@types/chance": "1.1.7",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.5",
    "@types/jest": "30.0.0",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "24.10.1",
    "@types/sc-common": "1.0.2",
    "copyfiles": "2.4.1",
    "jest": "30.2.0",
    "jest-auto-stub": "1.0.8",
    "jest-junit": "16.0.0",
    "jest-micro-auto-stub": "1.0.9",
    "jest-sonar-reporter": "2.0.0",
    "npm-check-updates": "19.1.2",
    "prettier": "3.7.4",
    "ts-jest": "29.4.6",
    "ts-node": "10.9.2",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
}
